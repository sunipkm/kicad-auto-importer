	(text "LTC4376 RTM stuff\nQ1 is for main power switch\nD1, D2, D4, D9, and D10 are for \nreverse, short, and OVP protections "
		(exclude_from_sim no)
		(at 276.098 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "05cacd23-98e3-4117-ab69-bf3365f89c26")
	)
	(text "Addressing:\nBase: 0b0100_[A1][A0]\nA -> GND: 0b00\nA -> VCC: 0b01\nA -> SDA: 0b10\nA -> SCL: 0b11"
		(exclude_from_sim no)
		(at 146.05 163.068 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "13686d08-3f58-4da7-9434-e621342a52ba")
	)
	(text "Addressing:\nBase: 0b0100_[A1][A0]\nA -> GND: 0b00\nA -> VCC: 0b01\nA -> SDA: 0b10\nA -> SCL: 0b11"
		(exclude_from_sim no)
		(at 387.35 165.608 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "33315722-d25a-4ff5-bbb1-7983aec8225f")
	)
	(text "Use A1 ONLY IF not present at input"
		(exclude_from_sim no)
		(at 201.676 160.274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3a7db478-6744-4e5c-937a-3fd7fb8c9189")
	)
	(text "D11 is for RP Protection of U1\n"
		(exclude_from_sim no)
		(at 66.294 245.872 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "803c1012-1d56-42a8-9ea1-fb10803c2f59")
	)
	(text "PRE low / CLR high = Q = 1, ~{Q} = 0 (CLK & D states do not matter)\nPRE high / CLR low = Q = 0, ~{Q} = 1 (CLK & D states do not matter)\nPRE low / CLR low  = Q = 1, ~{Q} = 1 (CLK & D states do not matter)\nPRE high / CLR high / Clock UP / D Low = Q = 0, ~{Q} = 1\nPRE high / CLR high / Clock UP / D High = Q = 1, ~{Q} = 0\nQ2 Added to pull U4 pin 5 Q to 0 when both PRE & CLR are in a low state"
		(exclude_from_sim no)
		(at 397.002 313.182 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8d0281b2-ee6c-4e79-ad71-6edbdf6432ae")
	)
	(text "(RTM) R11 & C7 are for in-rush control\nLeave unpopulated if not required\n\nR35 and R36 are experimnets to eliminate\nbrief moment on when the batt/ps is enabled\nR12 & R36 needs to be very close to Q1 gate"
		(exclude_from_sim no)
		(at 258.826 85.852 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a19684d2-f192-477d-a3ff-89d0e9042ca6")
	)
	(text "NOTE: Damping resistors (R17 ~ R25) for 28 V input π-filter.\nProvides controlled loss to suppress LC resonance from harness inductance + low-ESR MLCC bank.\nPopulated as needed based on EMI/transient measurements.\nR17 ~ R25 normally 0 Ohm; populate only with (0.15 ~ 0.47 Ω) if ringing or EMI peaks observed when using the π-filter."
		(exclude_from_sim no)
		(at 400.304 76.708 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a81ac1ab-fb66-43dd-a809-debf9adbdc6f")
	)
